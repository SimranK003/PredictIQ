# Copy this file to .env and adjust values for your environment.
# Never commit the real .env file.

ENVIRONMENT=development

# --- Database ---
DATABASE_URL=postgresql+psycopg2://predictiq:predictiq@localhost:5432/predictiq

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=predictiq-churn

# --- API ---
API_CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE_MB=25

# --- Storage ---
DATASET_STORAGE_DIR=storage/datasets

# --- Model promotion policy ---
# Comma-separated metric keys a candidate's stored metrics dict must contain
# (non-null) before it can be promoted to production.
MODEL_PROMOTION_REQUIRED_METRICS=precision,recall,f1,roc_auc
# If true, promotion verifies the candidate's MLflow artifact actually
# exists (a live check against the tracking server) before promoting.
MODEL_PROMOTION_REQUIRE_ARTIFACT_CHECK=true

# --- Inference ---
# Batches at or below this size are processed synchronously in the request.
BATCH_PREDICTION_SYNC_MAX_RECORDS=50
# Hard cap on a single batch request, sync or async.
BATCH_PREDICTION_MAX_RECORDS=5000

# --- Monitoring (drift foundation; Phase 6 implements real detection) ---
DRIFT_MINIMUM_PREDICTIONS=30

# --- Async training jobs ---
TRAINING_JOB_MAX_RETRIES=2
TRAINING_JOB_RETRY_DELAY_SECONDS=15

# --- Logging ---
LOG_LEVEL=INFO
