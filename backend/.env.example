# Copy this file to .env and adjust values for your environment.
# Never commit the real .env file.

ENVIRONMENT=development

# --- Database ---
DATABASE_URL=postgresql+psycopg2://predictiq:predictiq@localhost:5432/predictiq

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=predictiq-churn

# --- API ---
API_CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE_MB=25

# --- Storage ---
DATASET_STORAGE_DIR=storage/datasets

# --- Model promotion policy ---
# Comma-separated metric keys a candidate's stored metrics dict must contain
# (non-null) before it can be promoted to production.
MODEL_PROMOTION_REQUIRED_METRICS=precision,recall,f1,roc_auc
# If true, promotion verifies the candidate's MLflow artifact actually
# exists (a live check against the tracking server) before promoting.
MODEL_PROMOTION_REQUIRE_ARTIFACT_CHECK=true

# --- Inference ---
# Batches at or below this size are processed synchronously in the request.
BATCH_PREDICTION_SYNC_MAX_RECORDS=50
# Hard cap on a single batch request, sync or async.
BATCH_PREDICTION_MAX_RECORDS=5000

# --- Monitoring / drift detection (see docs/monitoring.md) ---
# Operational thresholds, not universal statistical constants.
DRIFT_MIN_SAMPLES=100
DRIFT_KS_THRESHOLD=0.10
DRIFT_PSI_WARNING=0.10
DRIFT_PSI_CRITICAL=0.25
DRIFT_MAX_PREDICTIONS_SAMPLED=5000

# --- Async training jobs ---
TRAINING_JOB_MAX_RETRIES=2
TRAINING_JOB_RETRY_DELAY_SECONDS=15

# --- Logging ---
LOG_LEVEL=INFO

# --- Auth (Phase 9) ---
# HMAC-signs the session cookie (app/core/security.py). The default
# below is an obvious placeholder — generate a real one for anything
# beyond a throwaway local instance:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-insecure-secret-key-change-me
SESSION_COOKIE_NAME=predictiq_session
# Seconds until a session expires (default 8 hours).
SESSION_TTL_SECONDS=28800
# Set true only when served over HTTPS — over plain HTTP (this native
# setup) a Secure cookie is silently dropped by the browser.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
# Redis-backed fixed-window login rate limit, keyed by email+client IP.
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# Leave false here — this native setup has no reverse proxy in front of
# the backend, so request.client.host is already the real client IP.
# Only set true behind a proxy you actually trust to set
# X-Forwarded-For honestly (e.g. Render in production — see
# render.yaml). See app/routers/auth.py's _client_identifier.
TRUST_PROXY_HEADERS=false

# --- Object storage (Phase 10 — only used when DATASET_STORAGE_BACKEND=s3;
# irrelevant for native dev, which stays on the local filesystem) ---
DATASET_STORAGE_BACKEND=local
DATASET_STORAGE_S3_BUCKET=
DATASET_STORAGE_S3_PREFIX=datasets
DATASET_STORAGE_S3_REGION=
DATASET_STORAGE_S3_ENDPOINT_URL=
