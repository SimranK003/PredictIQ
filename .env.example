# Docker Compose environment — copy this file to .env (same directory as
# docker-compose.yml) and adjust as needed. Every value below is a
# non-secret local-development default; never commit a real .env file.
#
# This is separate from backend/.env(.example) and
# frontend/.env.local(.example), which configure the *native* (non-Docker)
# local setup described in the README's "Local setup" section — Docker
# Compose does not read those files. See README.md's "Docker setup"
# section for how the two relate.

# --- Postgres (shared by the app and, in a separate logical database,
# --- MLflow's backend store — see infra/postgres/init-multi-db.sh) ---
POSTGRES_USER=predictiq
POSTGRES_PASSWORD=predictiq
POSTGRES_DB=predictiq
MLFLOW_DB_NAME=mlflow
# Host port Postgres is published on, for connecting with a local psql/
# GUI client. Not used by any container-to-container connection.
POSTGRES_HOST_PORT=5432

# --- Redis ---
# Host port Redis is published on, for connecting with a local redis-cli.
REDIS_HOST_PORT=6379

# --- MLflow ---
MLFLOW_EXPERIMENT_NAME=predictiq-churn
# Host port the MLflow UI/API is published on.
MLFLOW_HOST_PORT=5001

# --- Backend / worker ---
API_CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE_MB=25
LOG_LEVEL=INFO
# Host port the FastAPI backend is published on.
BACKEND_HOST_PORT=8123

# --- Auth (Phase 9) ---
# HMAC-signs the session cookie (see app/core/security.py) — NOT a
# database/API credential by itself, but treat it as a real secret:
# anyone with it can forge a valid-looking signed cookie (it still needs
# a live Redis session to actually authenticate, but don't hand this
# out). The default below is an obvious placeholder that ships in
# version control — generate a real one for anything beyond a
# throwaway local instance, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-insecure-secret-key-change-me
# Set to "true" only once the stack is actually served over HTTPS —
# over plain HTTP (default local Docker setup) a Secure cookie would
# never be sent back by the browser, silently breaking login.
SESSION_COOKIE_SECURE=false

# --- Frontend ---
# Baked into the browser bundle at image build time (Next.js
# NEXT_PUBLIC_* convention) — this is the URL the browser calls, so it
# must be a host-reachable address (the backend's published port), never
# a Compose service name. Rebuild the frontend image after changing this.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8123
# Host port the frontend is published on.
FRONTEND_HOST_PORT=3000
